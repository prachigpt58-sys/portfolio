   ========================================================================== */
function initMUNSection() {
  const pillarsContainer = document.getElementById('mun-pillars-grid');
  const skillsContainer = document.getElementById('mun-skills-grid');
  if (!appState.munLeadership) return;

  if (pillarsContainer) {
    pillarsContainer.innerHTML = (appState.munLeadership.pillars || []).map((pillar, i) => `
      <div class="mun-pillar-card glass-card">
        <div class="card-edit-toolbar">
          <button class="card-action-icon-btn btn-delete" onclick="deleteMUNPillar(${i})">🗑️ Del</button>
        </div>
        <div class="pillar-number">0${i + 1}</div>
        <h4 class="pillar-title" data-edit-type="munPillar" data-edit-id="${i}" data-edit-field="title">${pillar.title}</h4>
        <p class="pillar-desc" data-edit-type="munPillar" data-edit-id="${i}" data-edit-field="desc">${pillar.desc}</p>
      </div>
    `).join('');
  }

  if (skillsContainer && appState.munLeadership.myVoiceMatters) {
    skillsContainer.innerHTML = (appState.munLeadership.myVoiceMatters.skillsGained || []).map((skill, i) => `
      <div class="voice-skill-item glass-panel">
        <div class="card-edit-toolbar">
          <button class="card-action-icon-btn btn-delete" onclick="deleteVoiceSkill(${i})">🗑️ Del</button>
        </div>
        <div class="voice-skill-icon">✦</div>
        <div class="voice-skill-info">
          <h5 class="voice-skill-name" data-edit-type="voiceSkill" data-edit-id="${i}" data-edit-field="name">${skill.name}</h5>
          <p class="voice-skill-desc" data-edit-type="voiceSkill" data-edit-id="${i}" data-edit-field="desc">${skill.desc}</p>
        </div>
      </div>
    `).join('');
  }

  refreshEditModeDOM();
}

window.deleteMUNPillar = function(idx) {
  if (confirm('Delete this MUN pillar?')) {
    appState.munLeadership.pillars.splice(idx, 1);
    saveState();
    initMUNSection();
    showToast('Pillar removed.', 'info');
  }
};

window.deleteVoiceSkill = function(idx) {
  if (confirm('Delete this voice skill?')) {
    appState.munLeadership.myVoiceMatters.skillsGained.splice(idx, 1);
    saveState();
    initMUNSection();
    showToast('Skill removed.', 'info');
  }
