/* ==========================================================================
   16. EXPORT CODE ACTIONS
   ========================================================================== */
function initExportActions() {
  const downloadJsBtn = document.getElementById('btn-download-data-js');
  const downloadJsonBtn = document.getElementById('btn-download-json');
  const copyJsBtn = document.getElementById('btn-copy-data-js');
  const downloadHtmlBtn = document.getElementById('btn-download-html');

  if (downloadJsBtn) {
    downloadJsBtn.addEventListener('click', () => {
      const dataStr = generateDataJsContent();
      downloadBlob(dataStr, 'data.js', 'application/javascript');
      showToast('data.js downloaded! Replace scripts/data.js in your project folder.', 'success');
      playSynthNote(780, 0.08);
    });
  }

  if (downloadJsonBtn) {
    downloadJsonBtn.addEventListener('click', () => {
      const jsonStr = JSON.stringify(appState, null, 2);
      downloadBlob(jsonStr, 'prachi_portfolio_backup.json', 'application/json');
      showToast('Portfolio JSON backup downloaded!', 'success');
    });
  }

  if (copyJsBtn) {
    copyJsBtn.addEventListener('click', () => {
      const dataStr = generateDataJsContent();
      if (navigator.clipboard) {
        navigator.clipboard.writeText(dataStr).then(() => {
          showToast('Copied data.js contents to clipboard! ✓', 'success');
          playSynthNote(840, 0.06);
        });
      }
    });
  }

  if (downloadHtmlBtn) {
    downloadHtmlBtn.addEventListener('click', () => {
      const clone = document.documentElement.cloneNode(true);
      clone.classList.remove('edit-mode-active');
      const dataScript = clone.querySelector('script[src*="data.js"]');
      if (dataScript) {
        const inlineScript = document.createElement('script');
        inlineScript.textContent = `\nconst PORTFOLIO_DATA = ${JSON.stringify(appState, null, 2)};\n`;
        dataScript.replaceWith(inlineScript);
      }
      const fullHtml = '<!DOCTYPE html>\n' + clone.outerHTML;
      downloadBlob(fullHtml, 'portfolio.html', 'text/html');
      showToast('Self-contained portfolio.html downloaded! Open it anywhere.', 'success');
    });
  }
}

function generateDataJsContent() {
  return `/**
 * PRACHI GUPTA - PORTFOLIO DATA STORE (EXPORTED)
 * Generated from Live Studio CMS
 */

const PORTFOLIO_DATA = ${JSON.stringify(appState, null, 2)};

if (typeof Object.freeze === 'function') {
  Object.freeze(PORTFOLIO_DATA);
}
`;
}

function downloadBlob(content, filename, contentType) {
  const blob = new Blob([content], { type: contentType });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

/* ==========================================================================
   17. CUSTOM SCI-FI CURSOR
   ========================================================================== */
function initCursor() {
  const dot = document.querySelector('.cursor-dot');
  const ring = document.querySelector('.cursor-ring');
  if (!dot || !ring) return;

  let mouseX = window.innerWidth / 2;
  let mouseY = window.innerHeight / 2;
  let ringX = mouseX;
  let ringY = mouseY;

  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
  });

  function renderRing() {
    ringX += (mouseX - ringX) * 0.18;
    ringY += (mouseY - ringY) * 0.18;
    ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
    requestAnimationFrame(renderRing);
  }
  renderRing();

  document.addEventListener('mouseover', (e) => {
    if (e.target.closest('a, button, input, textarea, select, .interactive-card, .clickable, .img-upload-trigger, .card-action-icon-btn, [data-editable], [data-edit-field]')) {
      ring.classList.add('cursor-hover');
      dot.classList.add('cursor-dot-hover');
    } else {
      ring.classList.remove('cursor-hover');
      dot.classList.remove('cursor-dot-hover');
    }
  });

  window.addEventListener('mousedown', () => ring.classList.add('cursor-click'));
  window.addEventListener('mouseup', () => ring.classList.remove('cursor-click'));
}

/* ==========================================================================
   18. WEB AUDIO SYNTHESIZER
   ========================================================================== */
let audioCtx = null;
let soundEnabled = false;

function initAudioSynth() {
  const soundBtn = document.getElementById('sound-toggle-btn');
  if (!soundBtn) return;

  soundBtn.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    if (soundEnabled && !audioCtx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (AudioContext) audioCtx = new AudioContext();
    }
    soundBtn.classList.toggle('active', soundEnabled);
    showToast(soundEnabled ? 'Audio feedback enabled' : 'Audio feedback muted', 'info');
    if (soundEnabled) playSynthNote(640, 0.08, 'sine');
  });
}

function playSynthNote(freq = 520, duration = 0.06, type = 'sine') {
  if (!soundEnabled || !audioCtx) return;
  try {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
  } catch (e) {}
}

/* ==========================================================================
   19. NAVBAR & SCROLL SPY
   ========================================================================== */
function initNavbar() {
  const header = document.querySelector('.site-header');
  const mobileToggle = document.querySelector('.mobile-nav-toggle');
  const mobileMenu = document.querySelector('.mobile-nav-drawer');
  const navLinks = document.querySelectorAll('.nav-link');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });

  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('open');
      mobileToggle.setAttribute('aria-expanded', isOpen);
      playSynthNote(480, 0.05);
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
        mobileToggle.setAttribute('aria-expanded', false);
      });
    });
  }

  const sections = document.querySelectorAll('section[id]');
  window.addEventListener('scroll', () => {
    let current = '';
    const scrollPos = window.scrollY + 200;

    sections.forEach(section => {
      const top = section.offsetTop;
      const height = section.offsetHeight;
      if (scrollPos >= top && scrollPos < top + height) {
        current = section.getAttribute('id');
      }
    });

    navLinks.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === `#${current}`) {
        link.classList.add('active');
      }
    });
  });
}

/* ==========================================================================
   20. MODALS & LIGHTBOXES
   ========================================================================== */
function initModals() {
  const modals = document.querySelectorAll('.modal-backdrop');
  const closeBtns = document.querySelectorAll('.modal-close-btn, [data-modal-close]');

  closeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modals.forEach(m => m.classList.remove('active'));
      document.body.style.overflow = '';
      playSynthNote(420, 0.04);
    });
  });

  modals.forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modals.forEach(m => m.classList.remove('active'));
      document.body.style.overflow = '';
    }
  });
}

/* ==========================================================================
   21. COMMAND PALETTE (CTRL+K)
   ========================================================================== */
function initCommandPalette() {
  const palette = document.getElementById('command-palette');
  const searchInput = document.getElementById('palette-search-input');
  const resultsContainer = document.getElementById('palette-results');
  const triggerBtns = document.querySelectorAll('.command-palette-trigger');

  if (!palette || !searchInput || !resultsContainer) return;

  const index = [
    { type: 'Navigation', title: 'Home & Hero', desc: 'Top introduction & quantum core', link: '#hero' },
    { type: 'Navigation', title: 'About Me', desc: 'Class 11 PCM, drives & vision', link: '#about' },
    { type: 'Navigation', title: 'My Journey', desc: 'Milestones, Olympiad & Parliamentary forums', link: '#journey' },
    { type: 'Navigation', title: 'Featured Projects', desc: 'SWAM, GreenSpark, Quantum Dots', link: '#projects' },
    { type: 'Navigation', title: 'Certificates & Achievements', desc: 'Verified awards & certificates gallery', link: '#certificates' },
    { type: 'Navigation', title: 'MUN & Leadership', desc: 'UN committees & youth diplomacy', link: '#mun-leadership' },
    { type: 'Navigation', title: 'Public Speaking', desc: 'Oratory, stage & science keynotes', link: '#public-speaking' },
    { type: 'Navigation', title: 'Scientific Skills', desc: 'Physics, Chemistry, Tech & Communication', link: '#skills' },
    { type: 'Navigation', title: 'Photo Wall Scrapbook', desc: 'Exhibition & competition photographs', link: '#photo-wall' },
    { type: 'Navigation', title: 'My Vision', desc: 'What I am building towards', link: '#vision' },
    { type: 'Navigation', title: 'Connect & Contact', desc: 'Direct transmission & mail connector', link: '#contact' },
    { type: 'Action', title: 'Toggle Edit Mode', desc: 'Enable inline text editing and card toolbars', action: () => document.getElementById('studio-toggle-edit').click() },
    { type: 'Action', title: 'Edit Bio & Profile', desc: 'Open full profile and contact form editor', action: () => openProfileEditor() },
    { type: 'Action', title: 'Add New Certificate', desc: 'Upload a new credential to gallery', action: () => document.getElementById('add-cert-modal').classList.add('active') },
    { type: 'Action', title: 'Add New Project', desc: 'Publish a new project card', action: () => document.getElementById('add-project-modal').classList.add('active') },
    { type: 'Action', title: 'Add Journey Milestone', desc: 'Add milestone to chronology', action: () => document.getElementById('add-milestone-modal').classList.add('active') },
    { type: 'Action', title: 'Export Updated Code', desc: 'Download data.js file with all current changes', action: () => document.getElementById('export-data-modal').classList.add('active') }
  ];

  function openPalette() {
    palette.classList.add('active');
    searchInput.value = '';
    searchInput.focus();
    renderResults(index);
    playSynthNote(750, 0.05);
  }

  function closePalette() {
    palette.classList.remove('active');
    searchInput.blur();
  }

  triggerBtns.forEach(btn => btn.addEventListener('click', openPalette));

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (palette.classList.contains('active')) closePalette();
      else openPalette();
    }
  });

  searchInput.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    if (!q) {
      renderResults(index);
      return;
    }
    const filtered = index.filter(item => 
      item.title.toLowerCase().includes(q) || 
      item.desc.toLowerCase().includes(q) ||
      item.type.toLowerCase().includes(q)
    );
    renderResults(filtered);
  });

  function renderResults(items) {
    if (items.length === 0) {
      resultsContainer.innerHTML = `<div class="palette-empty">No matching records found.</div>`;
      return;
    }
    resultsContainer.innerHTML = items.slice(0, 10).map((item, idx) => `
      <div class="palette-item glass-panel" data-palette-idx="${idx}">
        <div class="palette-item-left">
          <span class="palette-type-tag">${item.type}</span>
          <div>
            <div class="palette-item-title">${item.title}</div>
            <div class="palette-item-desc">${item.desc}</div>
          </div>
        </div>
        <span class="palette-item-action">Jump ↵</span>
      </div>
    `).join('');

    resultsContainer.querySelectorAll('.palette-item').forEach((el, idx) => {
      el.addEventListener('click', () => {
        const target = items[idx];
        closePalette();
        if (target.action) {
          target.action();
        } else if (target.link) {
          const section = document.querySelector(target.link);
          if (section) section.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  }
}

/* ==========================================================================
   22. CONTACT MODULE
   ========================================================================== */
function initContactModule() {
  const form = document.getElementById('portfolio-contact-form');
  const directEmailBtn = document.getElementById('btn-send-email-client');
  if (!form) return;

  function getFormPayload() {
    const name = form.querySelector('#contact-name').value.trim();
    const email = form.querySelector('#contact-email').value.trim();
    const subject = form.querySelector('#contact-subject').value;
    const msg = form.querySelector('#contact-message').value.trim();
    return { name, email, subject, msg };
  }

  if (directEmailBtn) {
    directEmailBtn.addEventListener('click', () => {
      const { name, email, subject, msg } = getFormPayload();
      if (!name || !email || !msg) {
        showToast('Please fill out Name, Email, and Message to open your email client.', 'warning');
        return;
      }

      const targetEmail = (appState.profile && appState.profile.email) ? appState.profile.email : 'contact.prachigupta@example.com';
      const emailSubject = `[Portfolio Transmission] ${subject} from ${name}`;
      const emailBody = `Hi Prachi,\n\nSender Name: ${name}\nSender Email: ${email}\nCategory: ${subject}\n\nMessage:\n${msg}\n\n---\nSent via Prachi Gupta Portfolio Direct Connect`;

      const mailtoUrl = `mailto:${encodeURIComponent(targetEmail)}?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
      
      playSynthNote(840, 0.1, 'sine');
      showToast('Opening your default email app...', 'info');
      window.location.href = mailtoUrl;
    });
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const { name, email, subject, msg } = getFormPayload();

    if (!name || !email || !msg) {
      showToast('Please fill out all transmission fields.', 'warning');
      return;
    }

    const btn = form.querySelector('.btn-direct-email');
    if (btn) btn.innerHTML = `<span>Transmitting Message...</span>`;

    playSynthNote(880, 0.12, 'sine');

    setTimeout(() => {
      showToast(`Transmission received from ${email}! Prachi will reply soon.`, 'success');
      form.reset();
      if (btn) {
        btn.innerHTML = `<span>Transmit Online Packet</span>`;
      }
    }, 1100);
  });
}

/* ==========================================================================
   23. COPY ACTIONS & TOAST
   ========================================================================== */
function initCopyActions() {
  document.querySelectorAll('[data-copy-target]').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetKey = btn.getAttribute('data-copy-target');
      let text = '';
      if (targetKey === 'profile.email') {
        text = (appState.profile && appState.profile.email) ? appState.profile.email : 'contact.prachigupta@example.com';
      }
      if (navigator.clipboard && text) {
        navigator.clipboard.writeText(text).then(() => {
          showToast(`Copied contact ID to clipboard: ${text}`, 'info');
          playSynthNote(640, 0.06);
        });
      }
    });
  });
}

function showToast(message, type = 'info') {
  let toastContainer = document.querySelector('.toast-container');
  if (!toastContainer) {
    toastContainer = document.createElement('div');
    toastContainer.className = 'toast-container';
    document.body.appendChild(toastContainer);
  }

  const toast = document.createElement('div');
  toast.className = `toast toast-${type} glass-card`;
  toast.innerHTML = `
    <span class="toast-dot"></span>
    <span class="toast-message">${message}</span>
  `;

  toastContainer.appendChild(toast);
  setTimeout(() => toast.classList.add('show'), 10);

  setTimeout(() => {
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 300);
  }, 4000);
}

/* ==========================================================================
   24. SCROLL REVEAL ANIMATIONS
   ========================================================================== */
function initScrollAnimations() {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
}
