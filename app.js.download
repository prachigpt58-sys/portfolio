/* ==========================================================================
   12. PUBLIC SPEAKING
   ========================================================================== */
function initSpeakingSection() {
  const catContainer = document.getElementById('speaking-categories-grid');
  const photosContainer = document.getElementById('speaking-photos-grid');
  if (!appState.publicSpeaking) return;

  if (catContainer) {
    catContainer.innerHTML = (appState.publicSpeaking.categories || []).map((cat, i) => `
      <div class="speaking-cat-card glass-panel">
        <div class="card-edit-toolbar">
          <button class="card-action-icon-btn btn-delete" onclick="deleteSpeakingCategory(${i})">🗑️ Del</button>
        </div>
        <div class="speaking-cat-header">
          <span class="speaking-wave-bar"></span>
          <h4 class="speaking-cat-title" data-edit-type="speakingCat" data-edit-id="${i}" data-edit-field="title">${cat.title}</h4>
        </div>
        <p class="speaking-cat-desc" data-edit-type="speakingCat" data-edit-id="${i}" data-edit-field="desc">${cat.desc}</p>
      </div>
    `).join('');
  }

  if (photosContainer) {
    photosContainer.innerHTML = (appState.publicSpeaking.photos || []).map(photo => `
      <div class="speaking-photo-card glass-card" data-photo-id="${photo.id}">
        <div class="card-edit-toolbar">
          <button class="card-action-icon-btn btn-delete" onclick="event.stopPropagation(); deleteSpeakingPhoto('${photo.id}')">🗑️ Del</button>
        </div>
        <img src="${photo.placeholder}" alt="${photo.caption}" class="speaking-img" loading="lazy">
        <div class="speaking-photo-caption">
          <span class="speaking-event-tag" data-edit-type="speakingPhoto" data-edit-id="${photo.id}" data-edit-field="event">${photo.event}</span>
          <p class="speaking-photo-text" data-edit-type="speakingPhoto" data-edit-id="${photo.id}" data-edit-field="caption">${photo.caption}</p>
        </div>

        <!-- In-Place Upload Trigger -->
        <button class="img-upload-trigger" title="Change Speaking Photo" onclick="event.stopPropagation(); openImageReplacer('speakingPhoto', '${photo.id}', '${photo.placeholder}', 'Change Speaking Photo')">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          <span>📷 Swap Photo</span>
        </button>
      </div>
    `).join('');

    photosContainer.querySelectorAll('.speaking-photo-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.img-upload-trigger') || e.target.closest('.card-edit-toolbar')) return;
        const img = card.querySelector('.speaking-img').src;
        const caption = card.querySelector('.speaking-photo-text').textContent;
        openGenericLightbox(img, caption, "Public Speaking & Keynote Showcase");
      });
    });
  }

  refreshEditModeDOM();
}

function promptAddSpeakingCategory() {
  const title = prompt('Enter Presentation/Speaking Category Title:');
  if (!title) return;
  const desc = prompt('Enter Category Description:');

  if (!appState.publicSpeaking) appState.publicSpeaking = { categories: [], photos: [] };
  if (!appState.publicSpeaking.categories) appState.publicSpeaking.categories = [];
  appState.publicSpeaking.categories.push({ title, desc: desc || '', icon: 'mic' });

  saveState();
  initSpeakingSection();
  showToast(`Speaking category "${title}" added!`, 'success');
}

window.deleteSpeakingCategory = function(idx) {
  if (confirm('Delete speaking category?')) {
    appState.publicSpeaking.categories.splice(idx, 1);
    saveState();
    initSpeakingSection();
    showToast('Category removed.', 'info');
  }
};

window.deleteSpeakingPhoto = function(photoId) {
  if (confirm('Delete speaking photo?')) {
    appState.publicSpeaking.photos = appState.publicSpeaking.photos.filter(x => x.id !== photoId);
    saveState();
    initSpeakingSection();
    showToast('Photo removed.', 'info');
  }
};

/* ==========================================================================
   13. SKILLS MATRIX
   ========================================================================= */
function initSkills() {
  const scienceContainer = document.getElementById('skills-science-grid');
  const commContainer = document.getElementById('skills-comm-grid');
  const leadContainer = document.getElementById('skills-lead-grid');
  if (!appState.skills) return;

  function renderSkillCards(container, list, colKey, colorClass) {
    if (!container || !list) return;
    container.innerHTML = list.map((item, idx) => `
      <div class="skill-item-card glass-panel ${colorClass}">
        <div class="card-edit-toolbar">
          <button class="card-action-icon-btn" onclick="openCardEditor('skill', '${idx}', '${colKey}')">✏️ Edit</button>
          <button class="card-action-icon-btn btn-delete" onclick="deleteSkill('${colKey}', ${idx})">🗑️ Del</button>
        </div>
        <div class="skill-top">
          <h4 class="skill-name" data-edit-type="skill" data-edit-id="${idx}" data-edit-subkey="${colKey}" data-edit-field="name">${item.name}</h4>
          <span class="skill-level-badge" data-edit-type="skill" data-edit-id="${idx}" data-edit-subkey="${colKey}" data-edit-field="level">${item.level}</span>
        </div>
        <p class="skill-desc" data-edit-type="skill" data-edit-id="${idx}" data-edit-subkey="${colKey}" data-edit-field="desc">${item.desc}</p>
      </div>
    `).join('');
  }

  renderSkillCards(scienceContainer, appState.skills.scienceTech, 'scienceTech', 'skill-cyan');
  renderSkillCards(commContainer, appState.skills.communication, 'communication', 'skill-violet');
  renderSkillCards(leadContainer, appState.skills.creativeLeadership, 'creativeLeadership', 'skill-magenta');

  refreshEditModeDOM();
}

window.openAddSkillModal = function(colName) {
  const modal = document.getElementById('add-skill-modal');
  const targetColInput = document.getElementById('skill-target-col');
  if (modal && targetColInput) {
    targetColInput.value = colName;
    modal.classList.add('active');
  }
};

function initAddSkillForm() {
  const form = document.getElementById('form-add-skill');
  if (!form) return;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const colName = document.getElementById('skill-target-col').value || 'scienceTech';
    const name = document.getElementById('skill-name-input').value.trim();
    const level = document.getElementById('skill-level-input').value.trim();
    const desc = document.getElementById('skill-desc-input').value.trim();

    const newSkill = { name, level, desc, icon: 'star' };

    if (!appState.skills) appState.skills = {};
    if (!appState.skills[colName]) appState.skills[colName] = [];
    appState.skills[colName].push(newSkill);

    saveState();
    initSkills();

    form.reset();
    document.getElementById('add-skill-modal').classList.remove('active');
    showToast(`Skill "${name}" added!`, 'success');
    playSynthNote(880, 0.1);
  });
}

window.deleteSkill = function(colKey, idx) {
  const skill = appState.skills[colKey][idx];
  if (confirm(`Delete skill "${skill ? skill.name : ''}"?`)) {
    appState.skills[colKey].splice(idx, 1);
    saveState();
    initSkills();
    showToast('Skill removed from matrix.', 'info');
  }
};

/* ==========================================================================
   14. PHOTO WALL / SCRAPBOOK
   ========================================================================== */
function initPhotoWall() {
  const container = document.getElementById('photo-wall-grid');
  const filterBtns = document.querySelectorAll('.wall-filter-btn');
  if (!container || !appState.photoWall) return;

  function renderWall(filter = 'All') {
    const list = filter === 'All'
      ? appState.photoWall
      : appState.photoWall.filter(p => p.tag.toLowerCase() === filter.toLowerCase() || (p.category && p.category.toLowerCase().includes(filter.toLowerCase())));

    container.innerHTML = list.map(item => `
      <div class="wall-card glass-card aspect-${item.aspect || 'landscape'}" data-wall-id="${item.id}">
        <div class="card-edit-toolbar">
          <button class="card-action-icon-btn" onclick="event.stopPropagation(); openCardEditor('photoWall', '${item.id}')">✏️ Edit</button>
          <button class="card-action-icon-btn btn-delete" onclick="event.stopPropagation(); deletePhotoWallItem('${item.id}')">🗑️ Delete</button>
        </div>

        <div class="wall-image-wrapper">
          <img src="${item.image}" alt="${item.title}" class="wall-img" loading="lazy">
          <div class="wall-overlay">
            <span class="wall-tag" data-edit-type="photoWall" data-edit-id="${item.id}" data-edit-field="tag">${item.tag}</span>
            <h4 class="wall-title" data-edit-type="photoWall" data-edit-id="${item.id}" data-edit-field="title">${item.title}</h4>
            <p class="wall-desc" data-edit-type="photoWall" data-edit-id="${item.id}" data-edit-field="desc">${item.desc}</p>
          </div>

          <!-- In-Place Upload Trigger -->
          <button class="img-upload-trigger" title="Change Photo" onclick="event.stopPropagation(); openImageReplacer('photoWall', '${item.id}', '${item.image}', 'Change Scrapbook Photo')">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span>📷 Swap Photo</span>
          </button>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.wall-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.img-upload-trigger') || e.target.closest('.card-edit-toolbar')) return;
        const id = card.getAttribute('data-wall-id');
        const item = appState.photoWall.find(p => p.id === id);
        if (item) {
          openGenericLightbox(item.image, item.title, `${item.category || ''} • ${item.tag}`);
          playSynthNote(600, 0.05);
        }
      });
    });

    refreshEditModeDOM();
  }

  renderWall('All');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tag = btn.getAttribute('data-filter');
      renderWall(tag);
      playSynthNote(500, 0.04);
    });
  });
}

function initAddPhotoForm() {
  const form = document.getElementById('form-add-photo');
  const dropzone = document.getElementById('photo-dropzone');
  const fileInput = document.getElementById('photo-file-input');
  const previewImg = document.getElementById('photo-preview-img');
  let selectedDataUrl = null;

  if (!form || !dropzone || !fileInput) return;

  dropzone.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) {
      readFileAsDataURL(file, (dataUrl) => {
        selectedDataUrl = dataUrl;
        previewImg.src = dataUrl;
        previewImg.style.display = 'block';
      });
    }
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const title = document.getElementById('photo-title-input').value.trim();
    const tag = document.getElementById('photo-tag-input').value;
    const aspect = document.getElementById('photo-aspect-input').value;
    const desc = document.getElementById('photo-desc-input').value.trim();

    if (!selectedDataUrl) {
      showToast('Please upload a photo image.', 'warning');
      return;
    }

    const newPhoto = {
      id: 'photo-' + Date.now(),
      title: title,
      tag: tag,
      category: `${tag} Archive`,
      desc: desc || 'Event photograph from student scientific and leadership activities.',
      image: selectedDataUrl,
      aspect: aspect
    };

    if (!appState.photoWall) appState.photoWall = [];
    appState.photoWall.unshift(newPhoto);

    saveState();
    initPhotoWall();

    form.reset();
    previewImg.style.display = 'none';
    selectedDataUrl = null;
    document.getElementById('add-photo-modal').classList.remove('active');
    showToast(`Photo "${title}" added to scrapbook!`, 'success');
    playSynthNote(880, 0.1);
  });
}

window.deletePhotoWallItem = function(id) {
  const p = appState.photoWall.find(x => x.id === id);
  if (confirm(`Delete photo "${p ? p.title : id}"?`)) {
    appState.photoWall = appState.photoWall.filter(x => x.id !== id);
    saveState();
    initPhotoWall();
    showToast('Photo removed from scrapbook.', 'info');
  }
};

function openGenericLightbox(src, title, subtitle) {
  const lightbox = document.getElementById('lightbox-modal');
  const imgEl = document.getElementById('lightbox-img');
  const titleEl = document.getElementById('lightbox-title');
  const orgEl = document.getElementById('lightbox-org');
  const metaEl = document.getElementById('lightbox-meta');

  if (!lightbox || !imgEl) return;

  imgEl.src = src;
  imgEl.alt = title;
  if (titleEl) titleEl.textContent = title;
  if (orgEl) orgEl.textContent = subtitle;
  if (metaEl) metaEl.textContent = "Digital Archive View";

  lightbox.classList.add('active');
  document.body.style.overflow = 'hidden';
}

